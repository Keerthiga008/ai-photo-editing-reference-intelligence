{
  "manifest_version": 3,
  "name": "AI Photo Editing & Reference Intelligence",
  "version": "1.0.0",
  "description": "AI-powered photo editing assistant with reference intelligence and Photoshop-ready workflows.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "AI Photo Editor",
    "default_popup": "src/popup/popup.html"
  },
  "side_panel": {
    "default_path": "src/side-panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected/injected-script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
